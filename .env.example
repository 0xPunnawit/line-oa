# Application
PORT=3000
NODE_ENV=development
SKIP_WEBHOOK_GUARD=true

# Database (SQLite)
DB_DATABASE=data/app.sqlite
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Line API
replyApiUrl=https://api.line.me/v2/bot/message/reply
messageContentUrl=https://api-data.line.me/v2/bot/message/:messageId/content
channelAccessToken=abc123
channelSecret=your_channel_secret_here

# Server OCR
HOST=https://test.com
ENDPOINT=/api/test
X_API_KEY=test-abc-1234
channel=test-1234
# Text To Command
TEXT_COMMAND_ENDPOINT=/api/text/command
# Speech To Command
AUDIO_COMMAND_ENDPOINT=/api/audio/command

# Encryption Key
ENCRYPTION_KEY=testt8jTwwrREO5cm/HDj0WnkeEHtY=

# AZURE TextToSpeech
AZURE_TEXT_ENDPOINT=https://eastus.tts.speech.microsoft.com/cognitiveservices/v1
OUTPUT_FORMAT=riff-16khz-16bit-mono-pcm
TYPE=application/ssml+xml
ENCRYPTION_OCP_KEY2=your_encrypted_key2_here